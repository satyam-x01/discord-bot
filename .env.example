DISCORD_TOKEN=put_your_bot_token_here
# Optional comma-separated extra words/phrases to moderate
EXTRA_BAD_WORDS=
# Optional Gemini API key. Without it, moderation uses the offline filter only.
GEMINI_API_KEY=
# Optional Gemini model name
GEMINI_MODEL=gemini-2.5-flash
# Optional path for incident history (on Railway, use /data/data.json with a volume mounted at /data)
DATA_PATH=
# Optional: restrict moderation to one server. Leave blank for every server the bot joins.
GUILD_ID=
